# KG-RAG 配置模板
# 复制为 .env 后按本机环境修改；不要把真实密钥提交到仓库。
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env

# ---- 模型后端：生产答案必须走本机 Ollama ----
LLM_PROVIDER=local
EMBEDDING_PROVIDER=local
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=qwen2.5:3b
LOCAL_EMBEDDING_MODEL=qwen3-embedding:0.6b
LOCAL_LLM_TIMEOUT=300
LOCAL_NUM_CTX=24576
# 仅当模型可能不吐 EOS 时设置；不设则使用模型默认值
# LOCAL_NUM_PREDICT=6144
LOCAL_THINKING_OFF=1

# ---- Neo4j ----
# NEO4J_URI 是建图/上传库；SERVING_NEO4J_URI 是问答查询库。
NEO4J_URI=bolt://localhost:7688
NEO4J_BUILD_URI=bolt://localhost:7688
SERVING_NEO4J_URI=bolt://localhost:7690
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# ---- 服务数据与端口 ----
# 填 data/manuals/ 下的手册文件名与对应的抽取/社区产物名
SERVING_MANUAL=your_manual.md
SERVING_EXTRACT=your_extract.json
SERVING_ROUND=your_round
SERVING_PORT=8001

# ---- 可选：OpenAI 兼容接口（建库抽取、出题、评测判分）----
# 生产问答不使用这些配置；答案生成固定走 LOCAL_LLM。
# API_BASE_URL=https://api.example.com/v1
# API_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=
# 多平台可写 API_BASE_URL_1 / DEEPSEEK_API_KEY_1 / API_MODEL_1 / API_QUOTA_1 ...
# FROZEN_API_HOSTS=host1.example.com,host2.example.com

# ---- 可选：API 鉴权（默认关闭）----
# 设置后除 /health、/ui、/docs 外，所有端点要求 X-API-Token 请求头。
# API_TOKEN=
